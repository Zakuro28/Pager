# Keep secrets, local data and dev-only files out of the image.
.git
.env
.env.*
!.env.example
node_modules
vendor
tests
docs
.claude
.playwright-mcp
.idea
.vscode

# Local database and backups
database/*.sqlite
database/*.sqlite*

# Generated at build/boot time inside the container
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
public/hot
